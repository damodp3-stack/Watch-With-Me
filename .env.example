# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MEDIA_PROVIDER: Selects the active catalog provider.
# Options: "open-media" (default, legitimate public-domain/licensed media), "mock" (development testing), "tmdb" (The Movie Database live metadata)
MEDIA_PROVIDER="open-media"

# PLAYBACK_PROVIDER: Selects the active playback provider.
# Options: "open-media" (default, legitimate public-domain/CC streams), "mock" (offline dev mock)
PLAYBACK_PROVIDER="open-media"

# ENABLE_MOCK_FALLBACK: Whether to fall back to mock data if the primary provider fails or is unconfigured.
# Default: false (production mode returns genuine provider errors instead of silent mock fallbacks)
ENABLE_MOCK_FALLBACK="false"

# TMDB_API_KEY: Optional API key for live TMDB metadata integration.
# Required only if MEDIA_PROVIDER is set to "tmdb".
TMDB_API_KEY=
